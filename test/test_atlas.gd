# ---------------------------------------------------------------------------
# Staleness — the baked skies are build artefacts, and they can go out of date
# ---------------------------------------------------------------------------
#
# data/atlas_layout*.tres are generated by tools/bake_atlas.py and committed. If
# the catalog changes and the bake isn't re-run — an import that half-failed, a
# hand-edited .tres, a merge that took one side — the Atlas keeps drawing the old
# sky and nothing complains. These tests make that loud.
#
# If one fails, the fix is almost always:  python3 tools/bake_atlas.py --all-filters

# The undirected edge set the catalog describes right now, as "a|b" keys with the
# pair sorted, so it can be compared to a bake regardless of which way round each
# edge was stored.
func _catalog_edge_keys(only_owned: bool = false, only_downloaded: bool = false) -> Dictionary:
	var present: Dictionary = {}
	for g in Data.all_games():
		if only_owned and not g.owned:
			continue
		if only_downloaded and g.file_location.strip_edges() == "":
			continue
		present[g.id] = true
	var keys: Dictionary = {}
	for g in Data.all_games():
		if not present.has(g.id):
			continue
		for other in g.games_influenced:
			if not present.has(other) or other == g.id:
				continue
			var a: String = String(g.id)
			var b: String = String(other)
			keys["%s|%s" % ([a, b] if a < b else [b, a])] = true
	return keys

func _baked_edge_keys(lay: AtlasLayout) -> Dictionary:
	var keys: Dictionary = {}
	var e: int = 0
	while e + 1 < lay.edges.size():
		var a: String = String(lay.id_at(lay.edges[e]))
		var b: String = String(lay.id_at(lay.edges[e + 1]))
		keys["%s|%s" % ([a, b] if a < b else [b, a])] = true
		e += 2
	return keys

# Star count alone doesn't catch a changed CONNECTION — add a link between two
# existing games and the star count is identical while the map is wrong.
func test_baked_sky_matches_the_catalogs_connections() -> void:
	if _layout == null:
		return
	var want: Dictionary = _catalog_edge_keys()
	var have: Dictionary = _baked_edge_keys(_layout)
	var missing: Array = []
	for k in want:
		if not have.has(k):
			missing.append(k)
	var extra: Array = []
	for k in have:
		if not want.has(k):
			extra.append(k)
	assert_eq(missing.size(), 0,
		"connections in the catalog but not in the bake (re-run tools/bake_atlas.py): %s"
		% str(missing.slice(0, 5)))
	assert_eq(extra.size(), 0,
		"connections in the bake but no longer in the catalog: %s" % str(extra.slice(0, 5)))

func test_baked_sky_matches_the_catalogs_games() -> void:
	if _layout == null:
		return
	var baked: Dictionary = {}
	for i in range(_layout.star_count()):
		baked[_layout.id_at(i)] = true
	for g in Data.all_games():
		assert_true(baked.has(g.id), "%s is in the catalog but has no star" % g.id)
	assert_eq(baked.size(), Data.all_games().size(), "and the bake holds nothing extra")

func test_filtered_skies_are_baked_from_the_same_catalog() -> void:
	for spec in [[Settings.GameFilter.OWNED, true, false], [Settings.GameFilter.DOWNLOADED, false, true]]:
		var lay: AtlasLayout = ATLAS.load_layout(int(spec[0]))
		if lay == null or lay.source_filter == "all":
			continue
		var want: Dictionary = _catalog_edge_keys(bool(spec[1]), bool(spec[2]))
		var have: Dictionary = _baked_edge_keys(lay)
		assert_eq(have.size(), want.size(),
			"the '%s' sky has as many links as that filter's catalog does" % lay.source_filter)
		for k in want:
			assert_true(have.has(k), "'%s' sky is missing %s" % [lay.source_filter, k])

# Degrees are read off the baked edge list, so a stale bake would also mis-size
# every star. Check them against the catalog directly.
func test_star_sizes_match_the_catalogs_connection_counts() -> void:
	if _layout == null:
		return
	var degree: Dictionary = {}
	for g in Data.all_games():
		degree[g.id] = 0
	for g in Data.all_games():
		for other in g.games_influenced:
			if degree.has(other) and other != g.id:
				degree[g.id] = int(degree[g.id]) + 1
				degree[other] = int(degree[other]) + 1
	for i in range(_layout.star_count()):
		assert_eq(_layout.degree_of(i), int(degree.get(_layout.id_at(i), -1)),
			"%s is drawn at the size its connection count says" % _layout.id_at(i))

