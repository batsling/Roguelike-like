# ── Godot 4 (main project) ──────────────────────────────────────────────
# Generated / import cache — regenerated locally on open.
# The repo tracks source only (.gd / .tscn / .tres / assets / images).
.godot/
*.import
*.uid
export_presets.cfg
# Godot imports any .csv under res:// as a TRANSLATION and writes one
# .translation per column beside it. research/*.csv are candidate lists, not
# locale files (research/.gdignore keeps Godot out of that folder now), so any
# generated siblings are cache.
*.translation

# ── legacy-web (old HTML/JS version) ────────────────────────────────────
node_modules/
dist/
.cache/
games-data.js.backup

# ── Python bytecode (generator/test scripts) ─────────────────────────────
__pycache__/
*.pyc
package.json
package-lock.json

# ── Influence research (tools/influence_research.py) ─────────────────────
# Steam page cache and scan output; reproducible, and large.
.influence_work/
# ── Every other kind of research (tools/research.py): wiki reads, briefs ──
.research_work/
