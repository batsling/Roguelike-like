# ── Godot 4 (main project) ──────────────────────────────────────────────
# Generated / import cache — regenerated locally on open.
# The repo tracks source only (.gd / .tscn / .tres / assets / images).
.godot/
*.import
*.uid
export_presets.cfg
# Godot imports any .csv under res:// as a TRANSLATION and writes one
# .translation per column beside it. docs/goal-candidates.csv is a spreadsheet
# paste queue, not a locale file, so its sixteen generated siblings are cache.
*.translation

# ── legacy-web (old HTML/JS version) ────────────────────────────────────
node_modules/
dist/
.cache/
games-data.js.backup

# ── Python bytecode (generator/test scripts) ─────────────────────────────
__pycache__/
*.pyc
package.json
package-lock.json
