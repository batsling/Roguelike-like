chance_lost = ""
choices = [{"id": "immerse", "text": "Immerse", "repeat": "stay", "repeat_max": 0, "results": ["The liquid burns against your skin, simultaneously freezing and scalding. Beneath the surface, something brushes against your legs—tendrils? Currents with purpose? But when the pain subsides, you feel... denser somehow. More substantial."], "gates": [], "effects": [{"type": "gain_max_hp", "value": 1}, {"type": "lose_hp", "value": 2}], "effects_text": "+1 Max Health, -2 Health", "goal": {}, "curse": {}, "play": {}, "chance": {}}, {"id": "linger", "text": "Linger", "repeat": "again", "repeat_max": 0, "results": ["The temperature keeps rising! How long can you endure before the steam cooks you from within?", "It keeps getting hotter! The pool's bubbling sounds like laughter. IT'S SO HOT!", "You wonder if this is what it's like to live in the Village of Demons? You have bathed so long you have lost track of time and your mind... It's nice in here. Really fantastic.", "If you bathe any longer you will die."], "gates": [{"choice": "immerse", "op": ">", "value": 0}], "effects": [{"type": "gain_max_hp", "value": 1}, {"type": "lose_hp", "scaled": {"value": "3.0+X"}}], "effects_text": "+1 Max Health, -{3.0+X} Health", "goal": {}, "curse": {}, "play": {}, "chance": {}}, {"id": "abstain", "text": "Abstain", "repeat": "end", "repeat_max": 0, "results": ["You decline the temptation of the waters, instead gathering crystalline salts that have formed along the edges. As you apply them to your skin, the pools churn and froth agitatedly."], "gates": [{"choice": "immerse", "op": "==", "value": 0}], "effects": [{"type": "gain_hp", "value": 3}], "effects_text": "+3 Health", "goal": {}, "curse": {}, "play": {}, "chance": {}}, {"id": "exit_baths", "text": "Exit Baths", "repeat": "end", "repeat_max": 0, "results": ["The heat finally gets to you, and you hop out of the bath."], "gates": [{"choice": "immerse", "op": ">", "value": 0}], "effects": [{"type": "none"}], "effects_text": "Nothing", "goal": {}, "curse": {}, "play": {}, "chance": {}}]
