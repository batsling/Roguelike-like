choices = [{"id": "immerse", "text": "Immerse", "repeat": "stay", "repeat_max": 0, "result": "The liquid burns against your skin, simultaneously freezing and scalding. Beneath the surface, something brushes against your legs—tendrils? Currents with purpose? But when the pain subsides, you feel... denser somehow. More substantial.", "gates": [], "effects": [{"type": "gain_max_hp", "value": 1}, {"type": "lose_hp", "value": 3}], "effects_text": "+1 Max Health, -3 Health", "goal": {}, "curse": {}, "play": {}}, {"id": "linger", "text": "Linger", "repeat": "again", "repeat_max": 0, "result": "", "gates": [{"choice": "immerse", "op": ">", "value": 0}], "effects": [{"type": "gain_max_hp", "value": 1}, {"type": "lose_hp", "scaled": {"value": "4.0+X"}}], "effects_text": "+1 Max Health, -{4.0+X} Health", "goal": {}, "curse": {}, "play": {}}, {"id": "abstain", "text": "Abstain", "repeat": "end", "repeat_max": 0, "result": "You decline the temptation of the waters, instead gathering crystalline salts that have formed along the edges. As you apply them to your skin, the pools churn and froth agitatedly.", "gates": [{"choice": "immerse", "op": "==", "value": 0}], "effects": [{"type": "gain_hp", "value": 3}], "effects_text": "+3 Health", "goal": {}, "curse": {}, "play": {}}, {"id": "exit_baths", "text": "Exit Baths", "repeat": "end", "repeat_max": 0, "result": "", "gates": [{"choice": "immerse", "op": ">", "value": 0}], "effects": [{"type": "none"}], "effects_text": "Nothing", "goal": {}, "curse": {}, "play": {}}]
