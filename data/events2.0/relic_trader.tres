choices = [{"id": "take_the_top_one", "text": "Take the Top One", "repeat": "end", "repeat_max": 0, "results": ["He takes <give> off you with both hands, tucks it somewhere inside the cloak, and presses <get> into your palm before you can change your mind."], "gates": [], "effects": [{"type": "trade_relic", "slot": 1}], "effects_text": "Trade <give> for <get>", "goal": {}, "curse": {}, "play": {}, "chance": {}}, {"id": "take_the_middle_one", "text": "Take the Middle One", "repeat": "end", "repeat_max": 0, "results": ["“Good eye.” <give> vanishes into the lining. <get> arrives in its place, still warm."], "gates": [], "effects": [{"type": "trade_relic", "slot": 2}], "effects_text": "Trade <give> for <get>", "goal": {}, "curse": {}, "play": {}, "chance": {}}, {"id": "take_the_bottom_one", "text": "Take the Bottom One", "repeat": "end", "repeat_max": 0, "results": ["He crouches, digs past three other things, and comes up with <get>. <give> is gone from your pack by the time he stands."], "gates": [], "effects": [{"type": "trade_relic", "slot": 3}], "effects_text": "Trade <give> for <get>", "goal": {}, "curse": {}, "play": {}, "chance": {}}, {"id": "trade_nothing", "text": "Trade Nothing", "repeat": "end", "repeat_max": 0, "results": ["You decline. The cloak closes. “Suit yourself,” he says, and is not there when you look back."], "gates": [], "effects": [{"type": "none"}], "effects_text": "Nothing", "goal": {}, "curse": {}, "play": {}, "chance": {}}]
