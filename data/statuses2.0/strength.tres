[gd_resource type="Resource" script_class="StatusData" load_steps=3 format=3 uid="uid://status2_strength"]

[ext_resource type="Script" path="res://scripts/resources/StatusData.gd" id="1_status"]
[ext_resource type="Texture2D" path="res://images2.0/statuses/Strength.png" id="2_img"]

[resource]
script = ExtResource("1_status")
id = &"strength"
display_name = "Strength"
kind = &"buff"
source_game = "Slay the Spire"
on_player_text = "Gain \"If the difficuly is increased X times, Gain +X Small Chests and X Bashes\""
on_enemy_text = "Gains \"and the difficulty must be increased X times\""
stackable = "Intensity"
on_player = {"mode": "goal", "condition": "the difficulty is increased {X} [time|times]", "reward": [{"type": "gain_chest", "scaled": {"value": "X"}, "choices": 1}, {"type": "gain_stat", "stat": "bash", "scaled": {"value": "X"}}], "reward_text": "+{X} [Small Chest|Small Chests], +{X} [Bash|Bashes]", "decay": false}
on_enemy = {"mode": "clause", "condition": "the difficulty must be increased {X} [time|times]", "reward": [], "reward_text": "", "decay": false}
file = "Strength"
image = ExtResource("2_img")
