[resource]
script = ExtResource("1_status")
id = &"marked"
display_name = "Marked"
kind = &"debuff"
source_game = "Mewgenics"
on_player_text = "Apply \"and you must get X achivements\" to all enemies. Decrease stack by 1 when completed."
