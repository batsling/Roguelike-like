[gd_resource type="Resource" script_class="StatusData" load_steps=3 format=3 uid="uid://status2_marked"]

[ext_resource type="Script" path="res://scripts/resources/StatusData.gd" id="1_status"]
[ext_resource type="Texture2D" path="res://images2.0/statuses/Marked.png" id="2_img"]

[resource]
script = ExtResource("1_status")
id = &"marked"
display_name = "Marked"
kind = &"debuff"
stackable = "Intensity"
max_stacks = 0
decrease = "Each Game"
wear = "game"
combat_text = "Damage taken increased by x2. Ignores shields."
player_combat_text = "Damage taken increased by x2. Ignores shields."
on_player = {"mode": "demand", "condition": "get 2 achievements in one run", "reward": [], "reward_text": "", "penalty": [{"type": "apply_status", "status": "strength", "target": "random", "value": 3}], "penalty_text": "a random enemy gains 3 Strength", "decay": false}
on_enemy = {"mode": "bonus", "condition": "you get 2 achievements in one run", "reward": [{"type": "chest_reward", "scaled": {"value": "X"}}], "reward_text": "+{X:chests}", "penalty": [], "penalty_text": "", "decay": false}
combat = {"damage_taken_mult": 2.0, "pierce_shields": true}
player_combat = {"damage_taken_mult": 2.0, "pierce_shields": true}
file = "Marked"
image = ExtResource("2_img")
