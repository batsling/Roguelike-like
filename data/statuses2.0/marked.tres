[gd_resource type="Resource" script_class="StatusData" load_steps=3 format=3 uid="uid://status2_marked"]

[ext_resource type="Script" path="res://scripts/resources/StatusData.gd" id="1_status"]
[ext_resource type="Texture2D" path="res://images2.0/statuses/Marked.png" id="2_img"]

[resource]
script = ExtResource("1_status")
id = &"marked"
display_name = "Marked"
kind = &"debuff"
source_game = "Mewgenics"
on_player_text = "Apply \"and you must get X achivements\" to all enemies. Decrease stack by 1 when completed."
on_enemy_text = "Gains \"and if you get X achivements, Gain a [chest reward]\" to all enemies."
stackable = "Intensity"
combat_text = "Damage taken increased by x2. Ignores shields."
enemy_only = false
on_player = {"mode": "clause", "condition": "you must get {X} [achievement|achievements]", "reward": [], "reward_text": "", "decay": true}
on_enemy = {"mode": "bonus", "condition": "you get {X} [achievement|achievements]", "reward": [{"type": "chest_reward", "scaled": {"value": "X"}}], "reward_text": "+{X:chests}", "decay": true}
combat = {"damage_taken_mult": 2.0, "pierce_shields": true}
file = "Marked"
image = ExtResource("2_img")
