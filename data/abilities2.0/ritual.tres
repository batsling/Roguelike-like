[gd_resource type="Resource" script_class="AbilityData" load_steps=2 format=3 uid="uid://ability_ritual"]

[ext_resource type="Script" path="res://scripts/resources/AbilityData.gd" id="1_ability"]

[resource]
script = ExtResource("1_ability")
id = &"ritual"
display_name = "Ritual"
kind = &"intent"
variables = ""
params = PackedStringArray()
description = "Will not move or attack on it's first turn, but every turn after that it Gains +1 Strength"
effect = "first_turn: idle; turn: gain_status strength 1 free"
triggers = {
    &"first_turn": [{"op": &"idle", "args": PackedStringArray()}],
    &"turn": [{"op": &"gain_status", "args": PackedStringArray("strength", "1", "free")}]
}
file = "Ritual"
