[gd_resource type="Resource" script_class="AbilityData" load_steps=2 format=3 uid="uid://ability_split"]

[ext_resource type="Script" path="res://scripts/resources/AbilityData.gd" id="1_ability"]

[resource]
script = ExtResource("1_ability")
id = &"split"
display_name = "Split"
kind = &"death"
variables = "Amount, Enemy Type"
params = PackedStringArray("amount", "enemy")
description = "On Death, Splits into X number of Y type Enemies"
effect = "death: summon_here X Y"
triggers = {
    &"death": [{"op": &"summon_here", "args": PackedStringArray("X", "Y")}]
}
file = "Split"
