[gd_resource type="Resource" script_class="AbilityData" load_steps=2 format=3 uid="uid://ability_undying"]

[ext_resource type="Script" path="res://scripts/resources/AbilityData.gd" id="1_ability"]

[resource]
script = ExtResource("1_ability")
id = &"undying"
display_name = "Undying"
kind = &"death"
variables = "Amount"
params = PackedStringArray("amount")
description = "On Death, will revive at the rightmost column at the start of the next combat X times"
effect = "spawn: set_revives X; death: revive_next_game"
triggers = {
    &"spawn": [{"op": &"set_revives", "args": PackedStringArray("X")}],
    &"death": [{"op": &"revive_next_game", "args": PackedStringArray()}]
}
file = "Undying"
