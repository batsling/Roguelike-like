; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this is the canonical reference if you want to know the format.

config_version=5

[application]

config/name="Roguelike"
config/description="A roguelike deckbuilder played on a graph of real video games"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
Data="*res://scripts/autoload/Data.gd"
EffectSystem="*res://scripts/autoload/EffectSystem.gd"
TriggerBus="*res://scripts/autoload/TriggerBus.gd"
Stats="*res://scripts/autoload/Stats.gd"
GameLog="*res://scripts/autoload/GameLog.gd"
Notifications="*res://scripts/autoload/Notifications.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
Settings="*res://scripts/autoload/Settings.gd"
TierList="*res://scripts/autoload/TierList.gd"
GameStats="*res://scripts/autoload/GameStats.gd"
DevTools="*res://scripts/autoload/DevTools.gd"
ScrollSystem="*res://scripts/autoload/ScrollSystem.gd"
GameLoop2="*res://scripts/autoload/GameLoop2.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

# The games-first build is click-driven; the only key binding left is the one
# the Collection listens for (Tab) to close itself.
backpack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194306,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
