; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this is the canonical reference if you want to know the format.

config_version=5

[application]

config/name="Roguelike"
config/description="A roguelike deckbuilder played on a graph of real video games"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Profiles="*res://scripts/autoload/Profiles.gd"
GameState="*res://scripts/autoload/GameState.gd"
Data="*res://scripts/autoload/Data.gd"
EffectSystem="*res://scripts/autoload/EffectSystem.gd"
TriggerBus="*res://scripts/autoload/TriggerBus.gd"
Stats="*res://scripts/autoload/Stats.gd"
GameLog="*res://scripts/autoload/GameLog.gd"
Notifications="*res://scripts/autoload/Notifications.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
Settings="*res://scripts/autoload/Settings.gd"
Ownership="*res://scripts/autoload/Ownership.gd"
RunConfig="*res://scripts/autoload/RunConfig.gd"
TierList="*res://scripts/autoload/TierList.gd"
GameStats="*res://scripts/autoload/GameStats.gd"
DevTools="*res://scripts/autoload/DevTools.gd"
ScrollSystem="*res://scripts/autoload/ScrollSystem.gd"
PillSystem="*res://scripts/autoload/PillSystem.gd"
PotionSystem="*res://scripts/autoload/PotionSystem.gd"
CardSystem="*res://scripts/autoload/CardSystem.gd"
WandSystem="*res://scripts/autoload/WandSystem.gd"
LootSystem="*res://scripts/autoload/LootSystem.gd"
GameLoop2="*res://scripts/autoload/GameLoop2.gd"
EventSystem="*res://scripts/autoload/EventSystem.gd"
ObjectSystem="*res://scripts/autoload/ObjectSystem.gd"
ShopSystem="*res://scripts/autoload/ShopSystem.gd"

[display]

; The LAYOUT's size is 1280x720 and stays 1280x720 on every monitor: stretch/mode
; "canvas_items" scales that fixed canvas up to fill the window, so a 2560x1440
; screen draws the same page at 2x rather than a bigger page. The overworld is
; built to fit this box exactly (test_overworld2's one-window tests pin it).
;
; aspect "expand" rather than the default "keep": keep letterboxes anything that
; isn't 16:9 (a 16:10 monitor gets bars top and bottom, an ultrawide gets them at
; the sides), while expand hands the extra back as real canvas. It can only ever
; give MORE than 1280x720, never less, so the layout's one-screen guarantee holds
; and a wider or taller monitor gets used instead of framed.
;
; size/mode 0 is Godot's WINDOWED — an ordinary 1280x720 window, and the default
; on purpose. The whole loop here is leaving the game to go and play a real one,
; so the player alt-tabs out several times per run: a window that leaves the OS's
; taskbar/dock reachable is the one that fits that, and it is also the only mode
; where the 1280x720 the layout is built for is what you actually see. The two
; fullscreen modes are still on the Settings list — mode 3 (FULLSCREEN, a
; borderless window the size of the screen) and mode 4 (EXCLUSIVE_FULLSCREEN) —
; and Settings.display_mode overrides this at boot when the player picks one.
; F11 toggles windowed <-> borderless from any screen.
;
; The WINDOW and the CANVAS are two different numbers and only one of them is
; 1280x720. viewport_width/height is the CANVAS — the fixed box the layout is
; built to fit, scaled up by stretch/mode below — and it must stay 1280x720.
; window_width/height_override is how big the window that canvas is drawn into
; OPENS: 2560x1440, so a 1440p screen gets the page at 2x rather than a quarter
; of the desktop. Settings.WINDOWED_SIZE holds the same pair and clamps it to
; whatever the screen actually leaves free, so a smaller monitor (or one with a
; taskbar) gets as much of it as fits rather than a window off the edge.
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=2560
window/size/window_height_override=1440
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

; The games-first build is click-driven, and Tab is the only key binding left:
; the Collection listens for it to close itself, and the overworld listens for it
; to open and shut the LOOT WINDOW (Overworld2._unhandled_input) — the two are
; never on screen at the same time, so the one action serves both.
; NOTE the leading ';': project.godot comments are ';', not '#'. A '#' line is
; parsed as part of the NEXT key, which silently renamed this action to
; "#Thegames-firstbuild...backpack" and left "backpack" undefined.
backpack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194306,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
; F11 = window mode toggle, handled by the Settings autoload so every screen gets
; it without forwarding. 4194342 is KEY_F11.
toggle_fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194342,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
